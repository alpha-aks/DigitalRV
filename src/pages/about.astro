---
import MainLayout from "../layouts/MainLayout.astro";
import Sponsors from "../components/sections/Sponsors.astro";
import Services from "../components/sections/Services.astro";
---

<MainLayout title="About Us | Nexus">
	<main class="space-y-20">
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-3">
            <div class="relative flex flex-col-reverse items-center md:flex-row" id="hero">
                <div class="row items-center py-5 md:pb-20 md:pt-10">
                    <div class="text-center space-y-10">
                        <h2 class="text-5xl font-medium leading-none md:text-6xl">We Build Direct <br> SMS Channels That <br> Drive Growth</h2>
                        <p class="mt-6 mb-8  text-xl font-normal leading-7 sm:mb-12">Nexus is a dedicated SMS marketing and automation platform, operated as a trade name of Avqenta Technologies LLP. We partner with ambitious brands to transform mobile text messaging into their highest-performing retention and revenue engine.</p>
                        <a class="px-9 py-5 bg-zinc-900 hover:bg-white text-white hover:text-black border rounded-2xl justify-items-center md:justify-items-start gap-2.5 inline-flex transition-all" href="/#contact">
                            <h2 class="text-center text-xl font-normal leading-7">Book a consultation</h2>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <Sponsors />
        <Services />
	</main>
</MainLayout>