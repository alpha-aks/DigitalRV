---
import MainLayout from "../layouts/MainLayout.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import Card from "../components/ui/Card.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import { Image } from "astro:assets";

import c1 from "../assets/pics/card-pic1.png";
import c2 from "../assets/pics/card-pic2.png";
import c3 from "../assets/pics/card-pic3.png";
import c4 from "../assets/pics/card-pic4.png";
import c5 from "../assets/pics/card-pic5.png";
import c6 from "../assets/pics/card-pic6.png";

// Definición detallada de cada servicio
const services = [
  {
    index: 1,
    titleTop: "SMS Campaign",
    titleBottom: "Marketing",
    img: c1,
    alt: "SMS Campaigns",
    description: "We design, write, and execute targeted bulk SMS and MMS broadcasts that generate immediate sales. From flash sales and product drops to seasonal promotions, we ensure 98% open rates and rapid conversions.",
    benefits: ["98% open rates within 3 minutes", "Hyper-targeted subscriber segmentation", "Custom trackable links & MMS media", "Instant revenue on demand"],
    cta: "Launch SMS Campaign",
    link: "/#contact",
  },
  {
    index: 2,
    titleTop: "Automated SMS",
    titleBottom: "Workflows",
    img: c2,
    alt: "SMS Automation",
    description: "Put your revenue on autopilot with smart behavioral SMS flows. We build high-converting welcome series, abandoned cart recovery, browse abandonment alerts, and automated reorder triggers that work 24/7.",
    benefits: ["Recover up to 35% of abandoned carts", "Zero-friction mobile checkout links", "Behavioral event-based triggers", "Seamless e-commerce integration"],
    cta: "Build SMS Automations",
    link: "/#contact",
  },
  {
    index: 3,
    titleTop: "Conversational &",
    titleBottom: "2-Way SMS",
    img: c3,
    alt: "Conversational SMS",
    description: "Transform one-way blasts into real customer relationships. Our 2-way SMS messaging allows customers to reply, ask product questions, receive personalized recommendations, and complete orders directly in the thread.",
    benefits: ["Higher customer satisfaction & trust", "Human-assisted & AI sales concierge", "Custom keyword triggers", "Higher lifetime customer value"],
    cta: "Explore 2-Way SMS",
    link: "/#contact",
  },
  {
    index: 1,
    titleTop: "Transactional &",
    titleBottom: "OTP Alerts",
    img: c4,
    alt: "Transactional SMS",
    description: "Deliver mission-critical text notifications with sub-second latency. We manage one-time passwords (OTP), order confirmations, shipping updates, and appointment reminders across global carrier routes.",
    benefits: ["Sub-second delivery speeds", "High-priority carrier delivery routes", "Global carrier network coverage", "Secure 2FA & OTP infrastructure"],
    cta: "Setup Transactional SMS",
    link: "/#contact",
  },
  {
    index: 2,
    titleTop: "Subscriber List",
    titleBottom: "Growth & Compliance",
    img: c5,
    alt: "SMS Compliance",
    description: "Rapidly expand your opt-in SMS subscriber database while staying 100% compliant with TCPA, CTIA, and carrier regulations. We design high-converting mobile popups, QR triggers, and keyword opt-in funnels.",
    benefits: ["Double-digit opt-in conversion rates", "Full TCPA & CTIA regulatory compliance", "Carrier-certified 10DLC registration", "Zero spam risk or penalty audits"],
    cta: "Grow Your SMS List",
    link: "/#contact",
  },
  {
    index: 3,
    titleTop: "SMS Analytics &",
    titleBottom: "Attribution",
    img: c6,
    alt: "SMS Analytics",
    description: "Gain complete transparency into your SMS performance with real-time analytics. We track delivery rates, click-through rates, revenue attribution, unsubscribe rates, and return on ad spend (ROAS).",
    benefits: ["Real-time revenue attribution", "Granular click & conversion tracking", "Carrier deliverability diagnostics", "Cohort LTV & retention insights"],
    cta: "View SMS Reporting",
    link: "/#contact",
  },
];
---

<MainLayout 
  title="Our Services | Digital RV" 
  description="Explore our specialized SMS marketing services, automated sequences, 2-way messaging, list growth, and ROI analytics from Digital RV."
>
  <div class="py-16 px-4 mx-auto max-w-screen-xl lg:py-24 lg:px-6">
    <div class="text-center mb-16">
      <h1 class="mb-4 text-5xl font-medium leading-none tracking-tight md:text-6xl">Our Services</h1>
      <p class="text-xl font-normal leading-7 mx-auto max-w-3xl">
        At Digital RV, we offer a comprehensive range of high-impact SMS marketing and automation services designed to turn customer mobile screens into your primary revenue driver.
      </p>
    </div>
    
    <div class="space-y-24">
      {services.map((service, index) => (
        <div class="service-item">
          <div class="mb-12">
            <ServiceCard
              index={service.index}
              titleTop={service.titleTop}
              titleBottom={service.titleBottom}
              img={service.img}
              alt={service.alt}
              link={service.link}
            />
          </div>
          
          <div class="grid md:grid-cols-2 gap-10 px-4">
            <div>
              <h3 class="text-2xl font-medium mb-4">What we offer</h3>
              <p class="mb-6">{service.description}</p>
              <a href={service.link} class="inline-flex items-center px-8 py-4 bg-green text-dark rounded-2xl hover:bg-dark hover:text-white transition-all font-medium">
                {service.cta}
                <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
            
            <div class="bg-gray rounded-2xl p-8">
              <h3 class="text-2xl font-medium mb-4">Benefits</h3>
              <ul class="space-y-4">
                {service.benefits.map(benefit => (
                  <li class="flex items-start">
                    <svg class="mr-2 w-5 h-5 mt-1 text-green" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-24 text-center">
      <Card>
        <div class="p-10 md:p-16">
          <h2 class="text-3xl md:text-4xl font-medium mb-6">Ready to transform your mobile customer engagement?</h2>
          <p class="mb-10 text-xl max-w-2xl mx-auto">
            Contact Digital RV today to discuss your SMS marketing strategy and discover how our campaigns can drive exponential revenue for your business.
          </p>
          <a href="/#contact" class="inline-flex items-center px-10 py-5 bg-dark text-white rounded-2xl hover:bg-green hover:text-dark transition-all font-medium text-xl">
            Get in touch
          </a>
        </div>
      </Card>
    </div>
  </div>
</MainLayout>

<style>
  .service-item:nth-child(even) {
    @apply bg-gray bg-opacity-20 py-16 -mx-4 px-4;
  }
  
  @media (min-width: 768px) {
    .service-item:nth-child(even) {
      @apply -mx-6 px-6;
    }
  }
</style>
