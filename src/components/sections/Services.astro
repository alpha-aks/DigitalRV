---
import SectionTitle from "../ui/SectionTitle.astro";
import ServiceCard from "../ui/ServiceCard.astro";
import Section from "./Section.astro";

import c1 from "../../assets/pics/card-pic1.png";
import c2 from "../../assets/pics/card-pic2.png";
import c3 from "../../assets/pics/card-pic3.png";
import c4 from "../../assets/pics/card-pic4.png";
import c5 from "../../assets/pics/card-pic5.png";
import c6 from "../../assets/pics/card-pic6.png";

const cards = [
  {
    index: 1,
    titleTop: "SMS Campaign",
    titleBottom: "Marketing",
    img: c1,
    alt: "SMS Campaigns",
    link: "/services",
  },
  {
    index: 2,
    titleTop: "Automated SMS",
    titleBottom: "Workflows",
    img: c2,
    alt: "SMS Automation",
    link: "/services",
  },
  {
    index: 3,
    titleTop: "Conversational &",
    titleBottom: "2-Way SMS",
    img: c3,
    alt: "Conversational SMS",
    link: "/services",
  },
  {
    index: 1,
    titleTop: "Transactional &",
    titleBottom: "OTP Alerts",
    img: c4,
    alt: "Transactional SMS",
    link: "/services",
  },
  {
    index: 2,
    titleTop: "Subscriber List",
    titleBottom: "Growth & Compliance",
    img: c5,
    alt: "SMS Compliance",
    link: "/services",
  },
  {
    index: 3,
    titleTop: "SMS Analytics &",
    titleBottom: "Attribution",
    img: c6,
    alt: "SMS Analytics",
    link: "/services",
  },
];

const description =
  "At nx-us and co, we engineer high-converting SMS marketing and automation solutions designed to drive immediate engagement and measurable revenue. Our core offerings include:";
---

<Section id="services">
  <div class="mt-[140px] mb-5">
    <SectionTitle sectionTitle="Services" description={description} />
    <div class="grid lg:grid-cols-2 lg:grid-rows-3 gap-10">
      {
        cards.map((card) => (
          <ServiceCard
            index={card.index}
            titleTop={card.titleTop}
            titleBottom={card.titleBottom}
            img={card.img}
            alt={card.alt}
            link={card.link}
          />
        ))
      }
    </div>
  </div>
</Section>
