---
import SectionTitle from "../ui/SectionTitle.astro";
import TeamCard from "../ui/TeamCard.astro";
import Section from "./Section.astro";

const description =
  "Meet the SMS marketing and retention specialists behind Nexus's industry-leading campaign performance";

// Team images
import p1 from "../../assets/team/aarav-sharma.jpg";
import p2 from "../../assets/team/priya-nair.jpg";
import p3 from "../../assets/team/aditya-patel.jpg";

const team = [
  {
    pic: p1,
    name: "Aarav Sharma",
    role: "CEO & Founder",
    description:
      "10+ years scaling direct-to-consumer communication, SMS automation architecture, and mobile growth.",
  },
  {
    pic: p2,
    name: "Priya Nair",
    role: "VP of SMS Strategy",
    description:
      "7+ years optimizing mobile customer journeys, carrier compliance, and subscriber retention.",
  },
  {
    pic: p3,
    name: "Aditya Patel",
    role: "Head of SMS Deliverability & Infrastructure",
    description:
      "5+ years in DLT registration, telecom carrier routing, and high-throughput delivery.",
  },
];
---

<Section id="about">
  <div class="mt-[140px]">
    <SectionTitle sectionTitle="Team" description={description} />
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10"
    >
      {
        team.map((member, index) => (
          <TeamCard
            key={index}
            pic={member.pic}
            name={member.name}
            role={member.role}
            description={member.description}
          />
        ))
      }
    </div>
  </div>
</Section>
