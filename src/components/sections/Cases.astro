---
import { Image } from "astro:assets";
import Card from "../ui/Card.astro";
import Section from "./Section.astro";

const cards = [
  {
    index: 0,
    title:
      "For a direct-to-consumer lifestyle brand, we launched segmented VIP flash sale SMS campaigns that generated a 38% conversion rate and $145,000 in sales within 6 hours.",
    link: "#cases",
  },
  {
    index: 1,
    title:
      "For an omnichannel fashion retailer, our automated SMS abandoned cart flows recovered 31% of lost checkouts, delivering an exceptional 42x ROI.",
    link: "#cases",
  },
  {
    index: 1,
    title:
      "For a health & wellness subscription service, we introduced 2-way conversational SMS for re-orders, slashing customer churn by 44% and increasing LTV by 2.4x.",
    link: "#cases",
  },
];

import larrow from "../../assets/icon3.svg";
import SectionTitle from "../ui/SectionTitle.astro";
---

<Section id="cases">
  <SectionTitle
    sectionTitle="Case Studies"
    description="Explore Real-Life Examples of Proven SMS Marketing Success and Rapid ROI from nx-us and co"
  />
  <div class="flex flex-col lg:flex-row justify-between rounded-[45px] p-1">
    {
      cards.map((card) => (
        <Card>
          <div class="flex p-[60px] h-full bg-dark text-gray rounded-[45px] m-[1px]">
            <div class="flex flex-col gap-5">
              <p>{card.title}</p>
              <a href={card.link} class="flex items-center gap-[15px]">
                <span class="text-green">Case Info</span>
                <picture>
                  <Image src={larrow} alt="Arrow pointing up right" />
                </picture>
              </a>
            </div>
          </div>
        </Card>
      ))
    }
  </div>
</Section>
