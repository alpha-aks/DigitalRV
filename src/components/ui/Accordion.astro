---
import AccordionItem from "./AccordionItem.astro";

const content = [
{
  index: 1,
  title: "Audience Segmentation & Compliance",
  description: "We begin by auditing your subscriber base, establishing strict TCPA/CTIA compliance, and segmenting contacts based on purchase history, customer lifetime value, and engagement patterns."
},
{
  index: 2,
  title: "High-Converting SMS Copywriting",
  description: "Our copy specialists craft punchy, 160-character messages and MMS creative designed with powerful urgency triggers, personalized tokens, and trackable shortlinks that compel clicks."
},
{
  index: 3,
  title: "Automation & Flow Integration",
  description: "We connect your store or CRM to automated SMS sequences including welcome series, abandoned cart recovery, browse abandonment, order alerts, and automated reorder reminders."
},
{
  index: 4,
  title: "Deliverability & Route Optimization",
  description: "We configure certified 10DLC and dedicated shortcode carrier routes, conducting carrier testing and smart send-time delivery to guarantee 99%+ deliverability."
},
{
  index: 5,
  title: "Two-Way Conversational Messaging",
  description: "Turn passive broadcast recipients into active buyers with 2-way SMS concierge, keyword response triggers, and real-time live agent handoff directly within the text thread."
},
{
  index: 6,
  title: "Revenue Tracking & Scaling",
  description: "We provide transparent, real-time attribution reports tracking click-through rates, revenue generated, and customer lifetime value, continually testing to scale your ROI."
}
];
---

{
  content.map((item) => {
    return (
      <AccordionItem
        index={item.index}
        title={item.title}
        description={item.description}
      />
    );
  })
}
