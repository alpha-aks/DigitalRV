# =============================================================================
# NEXUS - ENVIRONMENT CONFIGURATION
# =============================================================================

# Resend API Key (obtain from https://resend.com/api-keys)
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_your_api_key_here

# The sender address (using no-reply email as configured)
# Note: In Resend sandbox testing mode without a verified domain,
# you can temporarily use: Nexus <onboarding@resend.dev>
# Once your nexussms.in domain is verified in Resend DNS, use:
RESEND_FROM_EMAIL=Nexus <no-reply@nexussms.in>

# Where admin alerts for new leads, quotes, and support tickets will arrive
RESEND_TO_EMAIL=support@nexussms.in
